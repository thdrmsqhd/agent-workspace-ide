{
  "name": "agent-workspace-ide",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "eslint .",
    "typecheck": "npm run build:foundation && tsc -p packages/core/tsconfig.json --noEmit",
    "build:foundation": "tsc -p packages/contracts/tsconfig.json",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "build": "npm run build:foundation && npm run build:core",
    "test:unit": "npm run build && node --test tests/unit/*.test.mjs",
    "dev": "node scripts/desktop-not-ready.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3"
  }
}
