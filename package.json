{
  "name": "agent-workspace-ide",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "eslint .",
    "typecheck": "npm run build",
    "build:foundation": "tsc -p packages/contracts/tsconfig.json",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "build:persistence": "tsc -p packages/persistence/tsconfig.json",
    "build:worktrees": "tsc -p packages/worktrees/tsconfig.json",
    "build:diff": "tsc -p packages/diff/tsconfig.json",
    "build:ui": "tsc -p packages/ui/tsconfig.json",
    "build:files": "tsc -p packages/files/tsconfig.json",
    "build": "npm run build:foundation && npm run build:core && npm run build:persistence && npm run build:worktrees && npm run build:diff && npm run build:ui && npm run build:files && npm run build:processes && npm run build:attachments && npm run build:settings && npm run build:ide && npm run build:engine && npm run build:integration && npm run build:runtime && npm run build:recovery && npm run build:performance && npm run build:environment && npm run build:app-host",
    "test:unit": "npm run build && node --test tests/unit/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "verify:omp:tv003": "node scripts/verification/omp-rpc/run.mjs tv-003",
    "verify:omp:tv004": "node scripts/verification/omp-rpc/run.mjs tv-004",
    "verify:omp:tv006": "node scripts/verification/omp-rpc/run.mjs tv-006",
    "verify:theia:tv001": "node scripts/verification/theia-host/run.mjs tv-001",
    "verify:theia:workspace": "node scripts/verification/theia-host/probe-workspace.mjs",
    "dev": "node scripts/start-desktop.mjs",
    "build:processes": "tsc -p packages/processes/tsconfig.json",
    "build:attachments": "tsc -p packages/attachments/tsconfig.json",
    "build:settings": "tsc -p packages/settings/tsconfig.json",
    "build:ide": "tsc -p packages/ide-integration/tsconfig.json",
    "build:engine": "tsc -p packages/engine-omp/tsconfig.json",
    "build:integration": "tsc -p packages/integration/tsconfig.json",
    "build:runtime": "tsc -p packages/runtime/tsconfig.json",
    "build:recovery": "tsc -p packages/recovery/tsconfig.json",
    "build:performance": "tsc -p packages/performance/tsconfig.json",
    "perf:collect": "node scripts/perf-collect.mjs",
    "build:environment": "tsc -p packages/environment/tsconfig.json",
    "desktop:build": "node scripts/build-windows-app.mjs",
    "acceptance:summary": "node scripts/acceptance-summary.mjs",
    "reuse:evaluate": "node scripts/reuse-evaluate.mjs",
    "desktop:install": "npm --prefix apps/desktop install --ignore-scripts",
    "build:app-host": "tsc -p packages/app-host/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3"
  }
}
