{
  "name": "agent-workspace-ide-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Agent Workspace IDE standalone Windows desktop shell",
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/electron": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/plugin-ext": "1.75.0",
    "@theia/plugin-ext-vscode": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/terminal": "1.75.0",
    "@theia/vsx-registry": "1.75.0",
    "@theia/workspace": "1.75.0",
    "@awi/theia-product-extension": "file:../desktop-extension",
    "@awi/app-host": "file:../../packages/app-host",
    "@awi/attachments": "file:../../packages/attachments",
    "@awi/contracts": "file:../../packages/contracts",
    "@awi/core": "file:../../packages/core",
    "@awi/engine-omp": "file:../../packages/engine-omp",
    "@awi/persistence": "file:../../packages/persistence",
    "@awi/processes": "file:../../packages/processes",
    "@awi/runtime": "file:../../packages/runtime",
    "@awi/settings": "file:../../packages/settings",
    "@awi/ui": "file:../../packages/ui",
    "@awi/worktrees": "file:../../packages/worktrees"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0",
    "electron": "42.8.1",
    "electron-builder": "26.0.12"
  },
  "scripts": {
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "build": "theia build --app-target=electron --mode production",
    "download:plugins": "node ../../scripts/download-desktop-plugins.mjs",
    "start": "theia start",
    "package": "electron-builder --win nsis portable --publish never",
    "package:preview": "electron-builder --dir --publish never"
  },
  "theia": {
    "target": "electron"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "redhat.java": "https://open-vsx.org/api/redhat/java/1.57.2026092308/file/redhat.java-1.57.2026092308.vsix",
    "vscjava.vscode-java-debug": "https://open-vsx.org/api/vscjava/vscode-java-debug/0.59.0/file/vscjava.vscode-java-debug-0.59.0.vsix",
    "ms-python.python": "https://open-vsx.org/api/ms-python/python/2026.4.0/file/ms-python.python-2026.4.0.vsix",
    "ms-python.debugpy": "https://open-vsx.org/api/ms-python/debugpy/2026.6.0/file/ms-python.debugpy-2026.6.0.vsix",
    "vscode-icons-team.vscode-icons": "https://open-vsx.org/api/vscode-icons-team/vscode-icons/12.19.0/file/vscode-icons-team.vscode-icons-12.19.0.vsix",
    "ms-python.vscode-python-envs": "https://open-vsx.org/api/ms-python/vscode-python-envs/1.36.0/file/ms-python.vscode-python-envs-1.36.0.vsix"
  },
  "productName": "Agent Workspace IDE",
  "main": "lib/backend/electron-main.js",
  "build": {
    "appId": "com.thdrmsqhd.agentworkspaceide",
    "productName": "Agent Workspace IDE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "lib/**/*",
      "src-gen/**/*",
      "node_modules/**/*",
      "plugins/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Agent-Workspace-IDE-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
